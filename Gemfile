source "https://rubygems.org"

# Same gem set GitHub Pages uses to build the site, so local == live.
gem "github-pages", group: :jekyll_plugins

# No longer default gems in newer Rubies (webrick since 3.0, the rest from 3.4/3.5); Jekyll 3 needs them.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
